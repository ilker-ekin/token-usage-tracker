# ── Setup ────────────────────────────────────────────────────────────
# 1. Copy this file:            cp .env.example .env
# 2. Fill in the values below   (.env is gitignored — it never gets committed)
# 3. Run:                       npm install && npm run ask
#
# Never put your real key in this .example file or paste it into a
# terminal command — it would end up in git or your shell history.

# ── Anthropic ────────────────────────────────────────────────────────
# Create a key at https://platform.claude.com → Settings → API Keys.
# Tip: use a workspace-scoped key with a spend limit.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use (override per call with: npm run ask -- --model <id>)
# CLAUDE_MODEL=claude-opus-4-8

# ── Tracker ──────────────────────────────────────────────────────────
# Where the token-usage-tracker API runs (default from the README setup).
TRACKER_URL=http://localhost:8080

# Any member login works; these are the seeded demo credentials.
TRACKER_EMAIL=member1@acme.dev
TRACKER_PASSWORD=seed-password

# The project your usage gets booked under. List project ids with:
#   curl -s -X POST http://localhost:8080/auth/token \
#     -H 'Content-Type: application/json' \
#     -d '{"email":"member1@acme.dev","password":"seed-password"}' \
#   # then use the returned token:
#   curl -s http://localhost:8080/analytics/projects -H "Authorization: Bearer <token>"
TRACKER_PROJECT_ID=paste-a-project-uuid-here
